        timestamp_with_time_zone created_at
        timestamp_with_time_zone updated_at
    }
    LISTING_ENQUIRIES {
        bigint enquiry_id PK
        bigint listing_id FK
        bigint user_id FK
        text message
        varchar_20_ phone
        text request_type
        timestamp_with_time_zone created_at
        numeric_12_2_ offer_amount
        timestamp_with_time_zone contacted_at
        timestamp_with_time_zone updated_at
